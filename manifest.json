{
  "manifest_version": 2,
  "name": "YT Dark Video — Smart Mode",
  "version": "1.0.0",
  "description": "Darkens white slide/whiteboard backgrounds in YouTube videos. Smart Mode inverts only near-white regions using GPU filters — no ML, no CPU load. The teacher stays in original color.",
  "homepage_url": "https://github.com/Piyush1912/ComfortEye",
  "author": "Piyush Pratap Singh",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "browser_action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    },
    "default_title": "YT Dark Video"
  },
  "permissions": [
    "storage",
    "*://*.youtube.com/*"
  ],
  "applications": {
    "gecko": {
      "id": "comfort-eye@piyush1912",
      "strict_min_version": "57.0"
    }
  }
}
